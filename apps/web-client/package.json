{
    "name": "@nmm/web-client",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 0.0.0.0 --port 5173",
        "preview": "vite preview --host 0.0.0.0 --port 4173",
        "prebuild": "npm run routes:generate",
        "build": "tsc -p tsconfig.app.json --noEmit && vite build",
        "build:profile": "npm run routes:generate && tsc -p tsconfig.app.json --noEmit && vite build --mode profile",
        "routes:generate": "tsr generate",
        "typecheck": "tsc -p tsconfig.app.json --noEmit"
    },
    "dependencies": {
        "@nmm/shared": "file:../../packages/shared",
        "@nmm/ui": "file:../../packages/ui",
        "@tanstack/react-query": "^5.101.0",
        "@tanstack/react-router": "^1.170.15",
        "@tanstack/react-router-devtools": "^1.167.0",
        "@vitejs/plugin-react": "latest",
        "better-auth": "^1.6.15",
        "ky": "^2.0.2",
        "lucide-react": "^1.17.0",
        "nuqs": "^2.8.9",
        "react": "latest",
        "react-dom": "latest",
        "typescript": "latest",
        "vite": "latest"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.0",
        "@tanstack/router-cli": "^1.167.17",
        "@tanstack/router-plugin": "^1.168.18",
        "@types/react": "latest",
        "@types/react-dom": "latest",
        "tailwindcss": "^4.3.0"
    }
}
