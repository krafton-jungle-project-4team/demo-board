{
  "name": "@nmm/web-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen": "orval --config orval.config.ts",
    "dev": "vite --host 0.0.0.0 --port 5173",
    "prebuild": "npm run routes:generate",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
