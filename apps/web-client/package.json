    "@tanstack/react-router-devtools": "^1.167.0",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "^1.17.0",
    "nuqs": "^2.8.9",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/router-cli": "^1.167.17",
    "@tanstack/router-plugin": "^1.168.18",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "orval": "^8.15.0",
    "tailwindcss": "^4.3.0"
