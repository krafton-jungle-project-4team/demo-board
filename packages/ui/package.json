{
    "name": "@nmm/ui",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        "./components": "./src/components.ts",
        "./components/*": "./src/components/*.tsx",
        "./lib/*": "./src/lib/*.ts",
        "./styles/globals.css": "./src/styles/globals.css"
    },
    "imports": {
        "#components/*": "./src/components/*.tsx",
        "#hooks/*": "./src/hooks/*.ts",
        "#lib/*": "./src/lib/*.ts"
    },
    "scripts": {
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.17.0",
        "radix-ui": "^1.5.0",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0"
    },
    "peerDependencies": {
        "react": "latest",
        "react-dom": "latest"
    },
    "devDependencies": {
        "@types/react": "latest",
        "typescript": "latest"
    }
}
