            "schema": {
              "example": "/posts",
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "GitHub OAuth 승인 화면으로 리다이렉트한다."
          }
        },
        "summary": "GitHub OAuth 로그인 시작",
        "tags": [
          "auth"
        ]
      }
    },
