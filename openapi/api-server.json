{
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "AppController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "app"
        ]
      }
    },
    "/api/posts": {
      "get": {
        "description": "검색/페이지/정렬/보기 옵션을 받지만 더미 API라 결과는 고정 목록을 반환한다.",
        "operationId": "PostsController_findPosts",
        "parameters": [
          {
            "name": "view",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "table",
                "card"
              ],
              "type": "string"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "created-desc",
                "created-asc",
                "title-asc"
              ],
              "type": "string"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "type": "number"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "type": "number"
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostListResponseDto"
                }
              }
            }
          }
        },
        "summary": "게시글 목록 조회",
        "tags": [
          "posts"
        ]
      },
      "post": {
        "operationId": "PostsController_createPost",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePostDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostDto"
                }
              }
            }
          }
        },
        "summary": "게시글 생성 더미 응답",
        "tags": [
          "posts"
        ]
      }
    },
    "/api/posts/{id}": {
      "get": {
        "operationId": "PostsController_findPost",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "example": "post-1",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostDto"
                }
              }
            }
          }
        },
        "summary": "게시글 단건 조회",
        "tags": [
          "posts"
        ]
      },
      "patch": {
        "operationId": "PostsController_updatePost",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "example": "post-1",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePostDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostDto"
                }
              }
            }
          }
        },
        "summary": "게시글 수정 더미 응답",
        "tags": [
          "posts"
        ]
      },
      "delete": {
        "operationId": "PostsController_deletePost",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "example": "post-1",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeletePostResponseDto"
                }
              }
            }
          }
        },
        "summary": "게시글 삭제 더미 응답",
        "tags": [
          "posts"
        ]
      }
    }
  },
  "info": {
    "title": "NMM API",
    "description": "나만의 무기 만들기 보일러플레이트용 더미 API",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "PostDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "post-1"
          },
          "title": {
            "type": "string",
            "example": "보일러플레이트 구조 결정"
          },
          "excerpt": {
            "type": "string",
            "example": "라우터, 서버 상태, URL 상태를 분리한다."
          },
          "content": {
            "type": "string",
            "example": "게시판 기능은 스택 검증을 위한 최소 CRUD 화면으로 둔다."
          },
          "authorName": {
            "type": "string",
            "example": "sijun"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-06-08T10:00:00.000Z"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published"
            ],
            "example": "published"
          }
        },
        "required": [
          "id",
          "title",
          "excerpt",
          "content",
          "authorName",
          "createdAt",
          "status"
        ]
      },
      "PostListResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostDto"
            }
          },
          "page": {
            "type": "number",
            "minimum": 1,
            "example": 1
          },
          "pageSize": {
            "type": "number",
            "minimum": 1,
            "example": 10
          },
          "totalItems": {
            "type": "number",
            "minimum": 0,
            "example": 3
          },
          "totalPages": {
            "type": "number",
            "minimum": 1,
            "example": 1
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "totalItems",
          "totalPages"
        ]
      },
      "CreatePostDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "프론트 공통 스택 기록"
          },
          "excerpt": {
            "type": "string",
            "example": "TanStack Router와 Query를 연결한다."
          },
          "content": {
            "type": "string",
            "example": "OpenAPI 기반 codegen으로 화면 개발의 출발점을 만든다."
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published"
            ],
            "default": "draft"
          }
        },
        "required": [
          "title",
          "excerpt",
          "content"
        ]
      },
      "UpdatePostDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "수정된 제목"
          },
          "excerpt": {
            "type": "string",
            "example": "수정된 요약"
          },
          "content": {
            "type": "string",
            "example": "수정된 본문"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published"
            ]
          }
        }
      },
      "DeletePostResponseDto": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          },
          "id": {
            "type": "string",
            "example": "post-1"
          }
        },
        "required": [
          "ok",
          "id"
        ]
      }
    }
  }
}
