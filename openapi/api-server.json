  "info": {
    "title": "NMM API",
    "description": "나만의 무기 만들기 보일러플레이트용 게시판 API",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "nmm_session"
      },
      "session": {
        "scheme": "bearer",
        "bearerFormat": "session",
        "type": "http"
      }
    },
    "schemas": {
      "CompleteSignUpDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "sijun"
          }
        },
        "required": [
          "name"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "user-1"
          },
          "email": {
            "type": "string",
            "example": "sijun@example.com"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "example": "sijun"
          },
          "image": {
            "type": "string",
            "nullable": true,
            "example": "https://avatars.githubusercontent.com/u/1?v=4"
          },
          "role": {
            "type": "string",
            "enum": [
              "USER",
              "ADMIN"
            ],
            "example": "USER"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACTIVE",
              "SUSPENDED"
            ],
            "example": "ACTIVE"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-06-09T00:00:00.000Z"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "image",
          "role",
          "status",
          "createdAt"
        ]
      },
      "UpdateCurrentUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "sijun"
          }
        },
        "required": [
          "name"
        ]
      },
      "CommentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "comment-1"
          },
          "postId": {
            "type": "string",
            "example": "post-1"
          },
          "content": {
            "type": "string",
            "example": "좋은 기준입니다."
          },
          "authorId": {
            "type": "string",
            "example": "user-1"
          },
          "authorName": {
            "type": "string",
            "example": "sijun"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-06-09T00:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "example": "2026-06-09T00:00:00.000Z"
          }
        },
        "required": [
          "id",
          "postId",
          "content",
          "authorId",
          "authorName",
          "createdAt",
          "updatedAt"
        ]
      },
      "CommentListResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommentDto"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "CreateCommentDto": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "example": "좋은 기준입니다."
          }
        },
        "required": [
          "content"
        ]
      },
      "UpdateCommentDto": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "example": "수정된 댓글입니다."
          }
        }
      },
      "DeleteCommentResponseDto": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          },
          "id": {
            "type": "string",
            "example": "comment-1"
          }
        },
        "required": [
          "ok",
          "id"
        ]
      },
      "PostTagDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "tag-react"
          },
          "name": {
            "type": "string",
            "example": "react"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "PostDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "post-1"
          },
          "title": {
            "type": "string",
            "example": "보일러플레이트 구조 결정"
          },
          "excerpt": {
            "type": "string",
            "example": "라우터, 서버 상태, URL 상태를 분리한다."
          },
          "content": {
            "type": "string",
            "example": "게시판 기능은 스택 검증을 위한 최소 CRUD 화면으로 둔다."
          },
          "authorId": {
            "type": "string",
            "example": "user-1"
          },
          "authorName": {
            "type": "string",
            "example": "sijun"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-06-09T00:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "example": "2026-06-09T00:00:00.000Z"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostTagDto"
            }
          }
        },
        "required": [
          "id",
          "title",
          "excerpt",
          "content",
          "authorId",
          "authorName",
          "createdAt",
          "updatedAt",
          "tags"
        ]
      },
      "PostListResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostDto"
            }
          },
          "page": {
            "type": "number",
            "minimum": 1,
            "example": 1
          },
          "pageSize": {
            "type": "number",
            "minimum": 1,
            "example": 10
          },
          "totalItems": {
            "type": "number",
            "minimum": 0,
            "example": 3
          },
          "totalPages": {
            "type": "number",
            "minimum": 1,
            "example": 1
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "totalItems",
          "totalPages"
        ]
      },
      "CreatePostDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "프론트 공통 스택 기록"
          },
          "excerpt": {
            "type": "string",
            "example": "TanStack Router와 Query를 연결한다."
          },
          "content": {
            "type": "string",
            "example": "OpenAPI 기반 codegen으로 화면 개발의 출발점을 만든다."
          },
          "tagIds": {
            "default": [],
            "example": [
              "tag-react"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "title",
          "excerpt",
          "content"
        ]
      },
      "UpdatePostDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "수정된 제목"
          },
          "excerpt": {
            "type": "string",
            "example": "수정된 요약"
          },
          "content": {
            "type": "string",
            "example": "수정된 본문"
          },
          "tagIds": {
            "example": [
              "tag-react"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "DeletePostResponseDto": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          },
          "id": {
            "type": "string",
            "example": "post-1"
          }
        },
        "required": [
          "ok",
          "id"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "ok"
        ]
      }
    }
  }
}
