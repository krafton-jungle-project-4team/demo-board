              "type": "string"
            }
          },
          {
            "name": "code",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "세션 쿠키를 설정한 뒤 web 화면으로 리다이렉트한다."
          }
        },
        "summary": "GitHub OAuth callback 처리",
        "tags": [
          "auth"
        ]
      }
    },
