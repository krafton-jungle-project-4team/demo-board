    "/api/posts": {
      "get": {
        "description": "검색어, 태그, 페이지, 정렬, 보기 옵션을 받아 게시글 목록을 반환한다.",
        "operationId": "PostsController_findPosts",
        "parameters": [
          {
            "name": "view",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "table",
                "card"
              ],
              "type": "string"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "created-desc",
                "created-asc",
                "title-asc"
              ],
              "type": "string"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "type": "number"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "type": "number"
            }
          },
          {
            "name": "tagId",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostListResponseDto"
                }
              }
            }
          }
        },
        "summary": "게시글 목록 조회",
        "tags": [
          "posts"
        ]
      },
